# =============================================================================
# Plantilla de variables para producción.
#
#   1. Copiar a la raíz del repo como .env.prod
#   2. Reemplazar todos los valores "CAMBIAR_..."
#   3. No versionar .env.prod (ya está en .gitignore)
#
# Generar secretos:
#   openssl rand -base64 48
# =============================================================================

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_DB=ss-platform
POSTGRES_USER=ssant0
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_BD

# ── Bootstrap (solo se usa con el volumen vacío) ─────────────────────────────
# Mínimo 12 caracteres. Cambia la contraseña del admin después del primer login.
ADMIN_EMAIL=admin@cucii.edu.mx
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
TEACHER_EMAIL=docente@cucii.edu.mx
TEACHER_PASSWORD=CAMBIAR_PASSWORD_DOCENTE
PLANTEL_NOMBRE=CUCII

# ── API ──────────────────────────────────────────────────────────────────────
# Cadena de al menos 32 caracteres (HS256). Usa openssl rand -base64 48.
JWT_SECRET=CAMBIAR_JWT_SECRET
JWT_EXPIRATION=86400000

# Orígenes del frontend separados por coma.
CORS_ORIGINS=https://gestion.cucii.mx

# ── Caddy / HTTPS ────────────────────────────────────────────────────────────
# Debe existir un registro DNS A/AAAA de este subdominio apuntando al VPS.
API_DOMAIN=api.gestion.cucii.mx
ACME_EMAIL=admin@cucii.edu.mx

# ── Zona horaria ─────────────────────────────────────────────────────────────
TZ=America/Mexico_City
