# Copiar a .env y completar. NO versionar .env
# Este archivo es para correr el API en local (`./mvnw spring-boot:run`).
# Para el despliegue con Docker usa `deploy/.env.prod.example`.
SPRING_PROFILES_ACTIVE=dev

# ── Base de datos ────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ss-platform
DB_USER=ssant0
DB_PASSWORD=2004

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_por_secreto_seguro
JWT_EXPIRATION=86400000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes del frontend separados por coma. Con Cloudflare Pages incluye el
# dominio de producción y, si aplica, los preview deployments.
CORS_ORIGINS=https://gestion.cucii.mx
