# Copiar a .env y completar. NO versionar .env
# Perfil de Spring (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos ────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://db:5432/ss-platform
DB_USER=ssant0
DB_PASSWORD=cambiar_en_produccion

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_por_secreto_seguro
JWT_EXPIRATION=86400000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://gestion.cucii.mx
